---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<div class="giscus"></div>

<script>
	const theme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

	const mount = document.querySelector('.giscus');
	if (mount && !mount.querySelector('script')) {
		const script = document.createElement('script');
		script.src = 'https://giscus.app/client.js';
		script.async = true;
		script.crossOrigin = 'anonymous';
		script.setAttribute('data-repo', 'phuonghongnhut/phuonghongnhut.github.io');
		script.setAttribute('data-repo-id', 'R_kgDOVHkLSg');
		script.setAttribute('data-category', 'Announcements');
		script.setAttribute('data-category-id', 'DIC_kwDOVHkLSs4DJQt8');
		script.setAttribute('data-mapping', 'pathname');
		script.setAttribute('data-strict', '0');
		script.setAttribute('data-reactions-enabled', '1');
		script.setAttribute('data-emit-metadata', '0');
		script.setAttribute('data-input-position', 'bottom');
		script.setAttribute('data-theme', theme());
		script.setAttribute('data-lang', 'vi');
		mount.append(script);
	}

	const applyTheme = () => {
		const iframe = document.querySelector('iframe.giscus-frame');
		if (!(iframe instanceof HTMLIFrameElement)) return;
		iframe.contentWindow?.postMessage(
			{ giscus: { setConfig: { theme: theme() } } },
			'https://giscus.app',
		);
	};

	new MutationObserver(applyTheme).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['data-theme'],
	});

	window.addEventListener('message', (event) => {
		if (event.origin !== 'https://giscus.app') return;
		if (!event.data?.giscus) return;
		applyTheme();
	});
</script>

<style>
	.giscus {
		margin-top: 2.5rem;
	}
</style>
